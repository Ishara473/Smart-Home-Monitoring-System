rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Helper function: check if the requesting user is a member
    // of a specific home document.
    // ─────────────────────────────────────────────────────────────
    function isHomeMember(homeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/homes/$(homeId))
        && request.auth.uid in get(/databases/$(database)/documents/homes/$(homeId)).data.memberUserIds;
    }

    // ─────────────────────────────────────────────────────────────
    // USERS
    // Each user can only read and write their own document.
    // ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────────────────
    // HOMES
    // A user can access a home document only if their UID is
    // listed in the home's memberUserIds array.
    // For creation, the user must be the owner of the new home.
    // ─────────────────────────────────────────────────────────────
    match /homes/{homeId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.memberUserIds;
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.memberUserIds;
    }

    // ─────────────────────────────────────────────────────────────
    // FLOORS
    // Readable/writable only by members of the associated home.
    // ─────────────────────────────────────────────────────────────
    match /floors/{floorId} {
      allow create: if request.auth != null
        && isHomeMember(request.resource.data.homeId);
      allow read, update, delete: if request.auth != null
        && isHomeMember(resource.data.homeId);
    }

    // ─────────────────────────────────────────────────────────────
    // ROOMS
    // Readable/writable only by members of the associated home.
    // ─────────────────────────────────────────────────────────────
    match /rooms/{roomId} {
      allow create: if request.auth != null
        && isHomeMember(request.resource.data.homeId);
      allow read, update, delete: if request.auth != null
        && isHomeMember(resource.data.homeId);
    }

    // ─────────────────────────────────────────────────────────────
    // DEVICES
    // Readable/writable only by members of the associated home.
    // ─────────────────────────────────────────────────────────────
    match /devices/{deviceId} {
      allow create: if request.auth != null
        && isHomeMember(request.resource.data.homeId);
      allow read, update, delete: if request.auth != null
        && isHomeMember(resource.data.homeId);
    }

    // ─────────────────────────────────────────────────────────────
    // CAMERAS
    // Readable/writable only by members of the associated home.
    // ─────────────────────────────────────────────────────────────
    match /cameras/{cameraId} {
      allow create: if request.auth != null
        && isHomeMember(request.resource.data.homeId);
      allow read, update, delete: if request.auth != null
        && isHomeMember(resource.data.homeId);
    }

    // ─────────────────────────────────────────────────────────────
    // SCHEDULES
    // Readable/writable only by members of the associated home.
    // ─────────────────────────────────────────────────────────────
    match /schedules/{scheduleId} {
      allow create: if request.auth != null
        && isHomeMember(request.resource.data.homeId);
      allow read, update, delete: if request.auth != null
        && isHomeMember(resource.data.homeId);
    }

    // ─────────────────────────────────────────────────────────────
    // NOTIFICATIONS
    // Readable/writable only by members of the associated home.
    // ─────────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow create: if request.auth != null
        && isHomeMember(request.resource.data.homeId);
      allow read, update, delete: if request.auth != null
        && isHomeMember(resource.data.homeId);
    }

    // ─────────────────────────────────────────────────────────────
    // REPORTS
    // Readable/writable only by members of the associated home.
    // ─────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if request.auth != null
        && isHomeMember(request.resource.data.homeId);
      allow read, update, delete: if request.auth != null
        && isHomeMember(resource.data.homeId);
    }

  }
}
